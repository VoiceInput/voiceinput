---
import Base from "../../layouts/Base.astro";
import { docs, groups, renderDoc } from "../../lib/docs";
export function getStaticPaths() {
  return docs.map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}
const { doc } = Astro.props;
const rendered = await renderDoc(doc);
const headings = rendered.metadata.headings.filter(
  (heading) => heading.depth === 2,
);
---

<Base
  title={`${doc.title} — VoiceInput Docs`}
  description={`${doc.title} for VoiceInput, the open-source React voice input SDK. Integration examples, API reference, and the desktop beta support contract.`}
>
  <main class="docs-layout wrap" id="main">
    <aside class="docs-sidebar">
      <details open>
        <summary>Documentation</summary><nav aria-label="Documentation">
          {
            groups.map((group) => (
              <div class="nav-group">
                <h2>{group}</h2>
                {docs
                  .filter((item) => item.group === group)
                  .map((item) => (
                    <a
                      href={`/docs/${item.slug}`}
                      aria-current={doc.slug === item.slug ? "page" : undefined}
                    >
                      {item.title}
                    </a>
                  ))}
              </div>
            ))
          }
        </nav>
      </details>
    </aside>
    <article class="docs-article">
      <p class="doc-context">Documentation / {doc.group}</p><h1>
        {doc.title}
      </h1><div class="prose" set:html={rendered.code} /><div
        class="doc-bottom"
      >
        <a
          href={`https://github.com/VoiceInput/voiceinput/blob/main/${doc.source}`}
          >Edit this page on GitHub ↗</a
        ><span>Desktop beta · MIT</span>
      </div>
    </article>
    <aside class="docs-toc" aria-label="On this page">
      <div>
        <p>On this page</p>{
          headings.map((heading) => (
            <a href={`#${heading.slug}`}>{heading.text}</a>
          ))
        }
      </div>
    </aside>
  </main>
  <script>
    const menu = document.querySelector<HTMLDetailsElement>(
      ".docs-sidebar details",
    );
    if (menu && window.matchMedia("(max-width:700px)").matches)
      menu.open = false;
  </script>
</Base>
