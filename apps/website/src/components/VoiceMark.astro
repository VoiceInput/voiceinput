<svg
  class="voice-sculpture"
  viewBox="0 0 330 280"
  width="330"
  height="280"
  fill="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient
      id="voice-side"
      x1="40"
      y1="40"
      x2="260"
      y2="240"
      gradientUnits="userSpaceOnUse"
      ><stop stop-color="#bcc2cb"></stop><stop offset=".45" stop-color="#626b79"
      ></stop><stop offset="1" stop-color="#a7aeb8"></stop></linearGradient
    >
    <linearGradient
      id="voice-face"
      x1="60"
      y1="30"
      x2="250"
      y2="245"
      gradientUnits="userSpaceOnUse"
      ><stop stop-color="#fff"></stop><stop offset=".38" stop-color="#f2f4f7"
      ></stop><stop offset=".7" stop-color="#d9dde4"></stop><stop
        offset="1"
        stop-color="#b6beca"></stop></linearGradient
    >
    <linearGradient
      id="voice-edge"
      x1="80"
      y1="40"
      x2="260"
      y2="240"
      gradientUnits="userSpaceOnUse"
      ><stop stop-color="white"></stop><stop offset="1" stop-color="#c1c8d2"
      ></stop></linearGradient
    >
    <filter id="voice-shadow" x="-70%" y="-35%" width="240%" height="210%"
      ><feDropShadow
        dx="8"
        dy="16"
        stdDeviation="12"
        flood-color="#202226"
        flood-opacity=".13"></feDropShadow></filter
    >
  </defs>
  <g transform="translate(3 4) rotate(-12 165 140)" filter="url(#voice-shadow)">
    <g fill="url(#voice-side)" transform="translate(8 7)"
      ><rect x="55" y="112" width="34" height="64" rx="17"></rect><rect
        x="117"
        y="69"
        width="34"
        height="150"
        rx="17"></rect><rect x="179" y="27" width="34" height="234" rx="17"
      ></rect><rect x="241" y="94" width="34" height="100" rx="17"></rect></g
    >
    <g fill="url(#voice-face)" stroke="url(#voice-edge)" stroke-width="1.25"
      ><rect x="55" y="112" width="34" height="64" rx="17"></rect><rect
        x="117"
        y="69"
        width="34"
        height="150"
        rx="17"></rect><rect x="179" y="27" width="34" height="234" rx="17"
      ></rect><rect x="241" y="94" width="34" height="100" rx="17"></rect></g
    >
  </g>
</svg>
