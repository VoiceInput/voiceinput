---
interface Props {
  variant?: "compact" | "render";
  class?: string;
  size?: number;
}

const { variant = "compact", class: className, size = 30 } = Astro.props;
---

{
  variant === "render" ? (
    <picture class:list={["brand-mark-render", className]} aria-hidden="true">
      <source
        type="image/webp"
        srcset="/brand/voiceinput-3d-512.webp 512w, /brand/voiceinput-3d-1024.webp 1024w"
        sizes="(max-width: 520px) 135px, (max-width: 800px) 230px, 300px"
      />
      <img
        src="/brand/voiceinput-3d.png"
        width="1024"
        height="1024"
        alt=""
        loading="lazy"
        decoding="async"
      />
    </picture>
  ) : (
    <img
      class:list={["brand-mark", className]}
      src="/brand/voiceinput-3d-icon.png"
      width={size}
      height={size}
      alt=""
      aria-hidden="true"
      decoding="async"
    />
  )
}
