---
import { Tabs, TabItem } from "@astrojs/starlight/components";
import ExampleCode from "./ExampleCode.astro";
const sources = import.meta.glob<string>("../examples/*.{ts,tsx}", {
  query: "?raw",
  import: "default",
  eager: true,
});
const hook = sources["../examples/hook.tsx"]!;
const textarea = sources["../examples/textarea.tsx"]!;
const nextjs = sources["../examples/nextjs.ts"]!;
const hono = sources["../examples/hono.ts"]!;
---

<div class="code-panel">
  <Tabs>
    <TabItem label="Hook"
      ><ExampleCode
        code={hook}
        filename="composer.tsx"
        label="Hook"
        href="/docs/quickstart/"
      /></TabItem
    >
    <TabItem label="VoiceTextarea"
      ><ExampleCode
        code={textarea}
        filename="composer.tsx"
        label="VoiceTextarea"
        href="/docs/react/#voiceinput-and-voicetextarea"
      /></TabItem
    >
    <TabItem label="Server">
      <div class="server-examples">
        <Tabs>
          <TabItem label="Next.js"
            ><ExampleCode
              code={nextjs}
              filename="app/api/voice-token/route.ts"
              label="Next.js"
              href="/docs/quickstart/#3-create-the-token-route"
              server
            /></TabItem
          >
          <TabItem label="Hono"
            ><ExampleCode
              code={hono}
              filename="server.ts"
              label="Hono"
              href="/docs/vite-hono/"
              server
            /></TabItem
          >
        </Tabs>
      </div>
    </TabItem>
  </Tabs>
</div>
