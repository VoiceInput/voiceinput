---
import { Tabs, TabItem } from "@astrojs/starlight/components";
import ExampleCode from "./ExampleCode.astro";
const sources = import.meta.glob<string>("../examples/*.{ts,tsx}", {
  query: "?raw",
  import: "default",
  eager: true,
});
const hook = sources["../examples/hook.tsx"]!;
const textarea = sources["../examples/textarea.tsx"]!;
const nextjs = sources["../examples/nextjs.ts"]!;
const hono = sources["../examples/hono.ts"]!;
---

<section class="examples" aria-labelledby="examples-title">
  <h2 id="examples-title">Choose your React integration</h2>
  <div class="code-panel">
    <div class="client-examples">
      <Tabs>
        <TabItem label="Component"
          ><div class="example-choice">
            <ExampleCode
              code={textarea}
              filename="composer.tsx"
              label="Component"
              description="Ready-made voice field"
              href="/docs/react/#voiceinput-and-voicetextarea"
            />
          </div></TabItem
        >
        <TabItem label="Hook"
          ><div class="example-choice">
            <ExampleCode
              code={hook}
              filename="composer.tsx"
              label="Hook"
              description="Add voice to your own field"
              href="/docs/quickstart/"
            />
          </div></TabItem
        >
      </Tabs>
    </div>
  </div>
  <details class="server-setup">
    <summary>Server setup (required for both)</summary>
    <div class="server-examples">
      <Tabs>
        <TabItem label="Next.js"
          ><ExampleCode
            code={nextjs}
            filename="app/api/voice-token/route.ts"
            label="Next.js"
            href="/docs/quickstart/#3-create-the-token-route"
            server
          /></TabItem
        >
        <TabItem label="Hono"
          ><ExampleCode
            code={hono}
            filename="server.ts"
            label="Hono"
            href="/docs/vite-hono/"
            server
          /></TabItem
        >
      </Tabs>
    </div>
  </details>
</section>
