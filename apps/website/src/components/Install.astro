---
import { Tabs, TabItem } from "@astrojs/starlight/components";
const commands = {
  npm: "npm install @voiceinput/react@next @voiceinput/openai@next",
  pnpm: "pnpm add @voiceinput/react@next @voiceinput/openai@next",
};
---

<div class="install-tabs" aria-label="Install VoiceInput packages">
  <Tabs syncKey="package-manager">
    {
      Object.entries(commands).map(([label, command]) => (
        <TabItem label={label}>
          <div class="install">
            <>
              <code tabindex="0">
                <span class="command-tool">{label}</span>{" "}
                <span class="command-action">
                  {label === "npm" ? "install" : "add"}
                </span>{" "}
                <span class="command-package">@voiceinput/react@next</span>{" "}
                <span class="command-package">@voiceinput/openai@next</span>
              </code>
              <button
                type="button"
                class="copy-button"
                data-copy={command}
                aria-label={"Copy " + label + " install command"}
              >
                <svg
                  data-copy-icon
                  viewBox="0 0 20 20"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="7.5" y="7.5" width="9" height="9" rx="2.5" />
                  <path d="M12.5 4.75A1.25 1.25 0 0 0 11.25 3.5h-6.5A1.25 1.25 0 0 0 3.5 4.75v6.5a1.25 1.25 0 0 0 1.25 1.25" />
                </svg>
              </button>
            </>
          </div>
        </TabItem>
      ))
    }
  </Tabs>
</div>
<style>
  .install-tabs {
    margin-top: 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: #fff;
  }
  .install-tabs :global([role="tablist"]) {
    display: flex;
    padding: 0 6px;
    margin: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .install-tabs :global([role="tab"]) {
    display: flex;
    align-items: center;
    padding: 0 12px;
    min-height: 44px;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
    box-shadow: none;
    line-height: 1.5;
    white-space: nowrap;
    text-decoration: none;
    transition:
      color 160ms,
      box-shadow 160ms;
  }
  .install-tabs :global([role="tab"][aria-selected="true"]) {
    color: var(--ink);
    box-shadow: inset 0 -2px var(--ink);
  }
  .install-tabs :global([role="tab"]:hover:not([aria-selected="true"])) {
    color: var(--ink);
  }
  .install-tabs :global([role="tabpanel"]) {
    margin: 0;
  }
  .install {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px 15px;
    min-width: 0;
  }
  .install code {
    display: block;
    flex: 1;
    min-width: 0;
    font-size: var(--text-xs);
    white-space: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-mask-image: linear-gradient(
      to right,
      black calc(100% - 24px),
      transparent
    );
    mask-image: linear-gradient(to right, black calc(100% - 24px), transparent);
    line-height: 1.7;
    padding-block: 4px;
  }
  .install code::-webkit-scrollbar {
    display: none;
  }
  .install .command-tool {
    color: var(--blue);
    font-weight: 600;
  }
  .install .command-action {
    color: var(--ink);
    font-weight: 500;
  }
  .install .command-package {
    color: #3a4656;
  }
  .install code:focus-visible {
    outline: 2px solid var(--muted);
    outline-offset: 4px;
  }
  .install .copy-button {
    flex-shrink: 0;
    width: 32px;
    padding: 0;
  }
</style>
