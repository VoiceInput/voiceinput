---
import { Tabs, TabItem } from "@astrojs/starlight/components";
const commands = {
  npm: "npm install @voiceinput/react@next @voiceinput/openai@next",
  pnpm: "pnpm add @voiceinput/react@next @voiceinput/openai@next",
};
---

<div class="install-tabs" aria-label="Install VoiceInput with OpenAI">
  <Tabs syncKey="package-manager">
    {
      Object.entries(commands).map(([label, command]) => (
        <TabItem label={label}>
          <div class="install">
            <>
              <code tabindex="0">{command}</code>
              <button
                type="button"
                data-copy={command}
                aria-label={"Copy " + label + " install command"}
              >
                Copy
              </button>
            </>
          </div>
        </TabItem>
      ))
    }
  </Tabs>
</div>
<style>
  .install-tabs {
    margin-top: 24px;
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
  }
  .install-tabs :global([role="tablist"]) {
    display: flex;
    padding: 0 6px;
    margin: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .install-tabs :global([role="tab"]) {
    padding: 10px 12px;
    min-height: 40px;
    color: var(--muted);
    font-size: 13px;
    box-shadow: none;
    line-height: 1.5;
    text-decoration: none;
  }
  .install-tabs :global([role="tab"][aria-selected="true"]) {
    color: var(--ink);
    box-shadow: inset 0 -2px var(--ink);
  }
  .install-tabs :global([role="tabpanel"]) {
    margin: 0;
  }
  .install {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    min-width: 0;
  }
  .install code {
    font-size: 11px;
    white-space: normal;
    overflow-wrap: anywhere;
    line-height: 1.8;
    padding-block: 5px;
  }
  .install code:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 3px;
  }
  .install button {
    flex-shrink: 0;
    border: 0;
    background: var(--surface);
    border-radius: 4px;
    padding: 7px;
    min-height: 40px;
    min-width: 44px;
    font-size: 12px;
  }
</style>
