---
import { Code } from "astro:components";
interface Props {
  code: string;
  filename: string;
  label: string;
  href: string;
  server?: boolean;
}
const { code, filename, label, href, server = false } = Astro.props;
---

<div class="example-code">
  <div class="code-heading">
    <span>{filename}</span>
    <div class="code-heading-actions">
      {
        !server && (
          <a class="text-link code-heading-link" href={href}>
            See the full setup
          </a>
        )
      }
      <button
        type="button"
        class="copy-button"
        data-copy={code.trim()}
        aria-label={`Copy ${label} example`}
        ><span data-copy-label>Copy</span></button
      >
    </div>
  </div>
  <Code
    code={code.trim()}
    lang={filename.endsWith("tsx") ? "tsx" : "ts"}
    theme="github-light-high-contrast"
    tabindex="0"
    aria-label={`${label} code`}
  />
  {
    server && (
      <p class="code-footnote">
        <span>
          <code>app-auth</code> contains your authentication and quota
          helpers.{" "}
        </span>
        <a class="text-link" href={href}>
          Complete server setup
        </a>
      </p>
    )
  }
</div>
