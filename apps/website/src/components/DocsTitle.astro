---
import BrandMark from "./BrandMark.astro";
---

<a href="/" class="docs-wordmark" aria-label="VoiceInput home">
  <BrandMark size={30} />
  VoiceInput
  <span>Docs</span>
</a>
<style>
  .docs-wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.125rem;
    font-weight: 750;
    color: var(--sl-color-white);
    text-decoration: none;
    letter-spacing: -0.04em;
  }
  .docs-wordmark span {
    margin-left: 0.35rem;
    border-left: 1px solid var(--sl-color-gray-5);
    padding-left: 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    letter-spacing: 0;
  }
</style>
