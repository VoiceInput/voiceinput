---
import "@fontsource-variable/bricolage-grotesque";
import "@fontsource-variable/wix-madefor-text";
import "@fontsource/ibm-plex-mono/latin-400.css";
import VoiceMark from "../components/VoiceMark.astro";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "VoiceInput — Add voice input to your React app",
  description = "Add dictation to your existing React inputs and textareas. Choose OpenAI, ElevenLabs, or Deepgram. Open source, with cursor-aware editing and undo.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light" class="marketing-page">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://voiceinput.dev/social.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="header-sentinel"></div>
    <header class="header wrap">
      <a href="/" class="wordmark" aria-label="VoiceInput beta home"
        ><svg viewBox="0 0 30 30" width="27" height="27" aria-hidden="true"
          ><g stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
            ><path d="M4 12v6M11 7v16M18 3v24M25 10v10"></path></g
          ></svg
        >VoiceInput<span class="beta">beta</span></a
      >
      <nav aria-label="Main navigation">
        <a href="/docs/overview/">Docs</a><a href="/#demo">Demo</a><a
          class="github-link"
          href="https://github.com/VoiceInput/voiceinput"
          >GitHub <svg
            viewBox="0 0 16 16"
            width="13"
            height="13"
            fill="none"
            aria-hidden="true"
            ><path
              d="M4 12 12 4M4 4h8v8"
              stroke="currentColor"
              stroke-width="1.4"></path></svg
          ></a
        >
      </nav>
    </header>
    <slot />
    <footer class="footer wrap">
      <div class="footer-invitation">
        <div>
          <h2>Make room for voice.</h2>
          <p>Start with one field. Make it your own.</p>
          <a class="button primary" href="/docs/quickstart/"
            >Read the quickstart</a
          >
          <p class="footer-support">
            React 18.2+ and React 19. <a
              class="inline-link"
              href="/docs/support-policy/">Desktop beta support</a
            >
          </p>
        </div>
        <VoiceMark />
      </div>
      <div class="footer-bottom">
        <a class="wordmark" href="/"
          ><svg viewBox="0 0 30 30" width="32" height="32" aria-hidden="true"
            ><g stroke="currentColor" stroke-width="2.6" stroke-linecap="round"
              ><path d="M4 12v6M11 7v16M18 3v24M25 10v10"></path></g
            ></svg
          >VoiceInput</a
        >
        <span class="footer-note">Open source. Built to fit.</span>
        <nav aria-label="Footer navigation">
          <a href="/docs/overview/">Documentation</a>
          <a href="https://github.com/VoiceInput/voiceinput">GitHub</a>
          <a href="https://github.com/VoiceInput/voiceinput/blob/main/LICENSE"
            >MIT license</a
          >
          <a href="/docs/support-policy/">Support</a>
        </nav>
      </div>
    </footer>
    <div class="sr-only" id="copy-status" role="status" aria-live="polite">
    </div>
    <script>
      // Reveals the header hairline once the page leaves the very top, without
      // a scroll listener: a 1px sentinel at the document origin does the work.
      const header = document.querySelector<HTMLElement>(".header");
      const sentinel = document.querySelector(".header-sentinel");
      if (header && sentinel) {
        new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) header.removeAttribute("data-scrolled");
            else header.setAttribute("data-scrolled", "true");
          }
        }).observe(sentinel);
      }
    </script>
    <script>
      const copyTimers = new WeakMap<
        HTMLButtonElement,
        ReturnType<typeof setTimeout>
      >();
      const checkIcon =
        '<path d="m5 12 4 4L19 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />';
      document.addEventListener("click", async (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>(
          "[data-copy]",
        );
        if (!button) return;
        const text =
          button.dataset.copy ||
          button.parentElement?.querySelector("code")?.textContent ||
          "";
        const icon = button.querySelector<SVGSVGElement>("[data-copy-icon]");
        const label =
          button.querySelector<HTMLElement>("[data-copy-label]") ??
          (icon ? null : button);
        const original =
          button.dataset.copyOriginal ?? label?.textContent ?? "Copy";
        button.dataset.copyOriginal = original;
        if (icon && !icon.dataset.copyIcon) {
          icon.dataset.copyIcon = icon.innerHTML;
          icon.dataset.copyIconViewbox = icon.getAttribute("viewBox") ?? "";
        }
        const showCheck = () => {
          if (!icon) return;
          icon.setAttribute("viewBox", "0 0 24 24");
          icon.innerHTML = checkIcon;
        };
        const restoreIcon = () => {
          if (!icon) return;
          icon.setAttribute("viewBox", icon.dataset.copyIconViewbox ?? "");
          icon.innerHTML = icon.dataset.copyIcon ?? "";
        };
        clearTimeout(copyTimers.get(button));
        try {
          await navigator.clipboard.writeText(text);
          if (label) label.textContent = "Copied";
          showCheck();
          const status = document.getElementById("copy-status");
          if (status) status.textContent = "Copied to clipboard.";
        } catch {
          if (label) label.textContent = "Select and copy";
          const status = document.getElementById("copy-status");
          if (status)
            status.textContent =
              "Copy unavailable. Select the code and copy it with your keyboard.";
        }
        copyTimers.set(
          button,
          setTimeout(() => {
            if (label) label.textContent = original;
            restoreIcon();
            const status = document.getElementById("copy-status");
            if (status) status.textContent = "";
          }, 1800),
        );
      });
    </script>
  </body>
</html>
