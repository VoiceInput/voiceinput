{
  "name": "@voiceinput/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "typecheck": "astro check",
    "lint": "oxlint --config ../../.oxlintrc.json src scripts",
    "format:check": "prettier --check .",
    "deploy:preview": "wrangler deploy --env=\"\"",
    "deploy": "wrangler deploy --env production",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/react": "6.0.5",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@voiceinput/core": "workspace:*",
    "@voiceinput/provider": "workspace:*",
    "@voiceinput/react": "workspace:*",
    "astro": "7.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.183.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}
