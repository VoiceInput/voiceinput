{
  "name": "@voiceinput/core",
  "version": "0.1.0-beta.3",
  "description": "Framework-neutral, cursor-safe voice transcription sessions and browser audio.",
  "keywords": [
    "voice-input",
    "speech-to-text",
    "transcription",
    "audio"
  ],
  "homepage": "https://voiceinput.dev/docs/core",
  "bugs": {
    "url": "https://github.com/VoiceInput/voiceinput/issues"
  },
  "author": "VoiceInput contributors",
  "maintainers": [
    "Hirad Arshadi (https://github.com/hiradary)"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoiceInput/voiceinput.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "@voiceinput/provider": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm generate:worklet && tsdown src/index.ts",
    "dev": "pnpm generate:worklet && tsdown src/index.ts --watch --no-clean",
    "generate:worklet": "node ../../scripts/generate-audio-worklet.mjs",
    "pack": "pnpm pack --pack-destination .",
    "test": "node ../../scripts/generate-audio-worklet.mjs --check && vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "format:check": "prettier --check ."
  }
}
