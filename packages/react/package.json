{
  "name": "@voiceinput/react",
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "styles.css"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./styles.css"
  },
  "dependencies": {
    "@voiceinput/core": "workspace:*",
    "@voiceinput/provider": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "dev": "tsdown src/index.ts --watch --no-clean",
    "pack": "pnpm pack --pack-destination .",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "oxlint --config ../../.oxlintrc.json .",
    "format:check": "prettier --check ."
  }
}
