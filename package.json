{
  "name": "voiceinput",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": "11.23.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=20",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:e2e": "turbo run test:e2e",
    "validate:packages": "turbo run pack && node scripts/validate-packages.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.1",
    "@vitest/browser-playwright": "4.1.11",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "turbo": "2.10.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
